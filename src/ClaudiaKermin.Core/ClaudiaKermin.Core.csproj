<!--
  The Unity-free core (ADR 0001): mission orchestration, the Claude client, prompt building and
  Mission state. It must never reference Unity or KSP assemblies, so it builds and tests anywhere.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ClaudiaKermin.Core</AssemblyName>
    <RootNamespace>ClaudiaKermin.Core</RootNamespace>
    <ShipsInGameData>true</ShipsInGameData>
  </PropertyGroup>

  <!-- The Core Library ships inside the core, so bundling a Mission Script reads no files. -->
  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)kerboscript/library/*.ks" LogicalName="ClaudiaKermin.Core.library.%(Filename).ks" />
    <!-- RSVP v9 (GPL-3.0), which transfer plans with; bundled as described in kerboscript/rsvp/NOTE.md. -->
    <EmbeddedResource Include="$(RepoRoot)kerboscript/rsvp/*.ks" LogicalName="ClaudiaKermin.Core.rsvp.%(Filename).ks" />
  </ItemGroup>
</Project>
