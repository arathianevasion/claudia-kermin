<!--
  The thin KSP adapter (ADR 0001): game-state reads, crew roster and UI, feeding the core plain
  snapshots. Builds against a local KSP 1.12.5 install; see KSPRoot in Directory.Build.props.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ClaudiaKermin</AssemblyName>
    <RootNamespace>ClaudiaKermin.Adapter</RootNamespace>
    <NeedsKSP>true</NeedsKSP>
    <ShipsInGameData>true</ShipsInGameData>
    <!-- The one project that also stages the repo's GameData/ClaudiaKermin files (trait cfg, icon). -->
    <StagesGameDataFiles>true</StagesGameDataFiles>
  </PropertyGroup>

  <!-- Compile-only, as in ClaudiaKermin.KOS: players get 0Harmony.dll from HarmonyKSP 2.2.1.0. -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClaudiaKermin.Core/ClaudiaKermin.Core.csproj" />
  </ItemGroup>
</Project>
